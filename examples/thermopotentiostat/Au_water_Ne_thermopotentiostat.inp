&GLOBAL
  PROJECT Au_water_Ne_thermopotentiostat
  RUN_TYPE MD
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    WFN_RESTART_FILE_NAME Au_water_Ne-RESTART.wfn
    CHARGE 0
    
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
    &END MGRID
    
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    
    &SCF
      SCF_GUESS RESTART
      EPS_SCF 1.0E-6
      MAX_SCF 30
      &OUTER_SCF
        ! More outer SCF iterations for surface dipole to equilibrate
        MAX_SCF 30
        EPS_SCF 1.0E-6
      &END OUTER_SCF
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.01
        BETA 0.5
        NBROYDEN 5
      &END MIXING
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      ADDED_MOS -1
    &END SCF
    
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
!      ! Add dispersion correction for water-metal interface
!      &VDW_POTENTIAL
!        DISPERSION_FUNCTIONAL PAIR_POTENTIAL
!        &PAIR_POTENTIAL
!          TYPE DFTD3
!          PARAMETER_FILE_NAME dftd3.dat
!          REFERENCE_FUNCTIONAL PBE
!        &END PAIR_POTENTIAL
!      &END VDW_POTENTIAL
    &END XC
    
    ! Enable dipole moment calculation - REQUIRED for thermopotentiostat
    &PRINT
      &MOMENTS ON
        PERIODIC FALSE
        REFERENCE COM
      &END MOMENTS
    &END PRINT
    ! Surface dipole correction - REQUIRED for thermopotentiostat
    SURFACE_DIPOLE_CORRECTION .TRUE.
    SURF_DIP_DIR Z
  &END DFT
  
  &SUBSYS
    &CELL
      ABC 11.5400   11.5400   35.0000
      PERIODIC XYZ
    &END CELL
    
    &TOPOLOGY
      COORD_FILE_FORMAT XYZ
      COORD_FILE_NAME solvated_slab.xyz
    &END TOPOLOGY
    
    ! Gold - working electrode (will be controlled by thermopotentiostat)
    &KIND Au
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q11
    &END KIND
    
    ! Neon - counter electrode material
    &KIND Ne
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q8
    &END KIND
    
    ! Oxygen
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    
    ! Hydrogen
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &MD
    ENSEMBLE THERMOPOTENTIOSTAT
    TIMESTEP 0.5
    STEPS 10000
    TEMPERATURE 300.0
    
    ! Thermopotentiostat settings - control electrochemical potential
    ! by adjusting the effective nuclear charge of Au atoms based on
    ! the system dipole moment in the z-direction (perpendicular to slabs)
    &THERMOPOTENTIOSTAT
      ! Target potential in Volts
      ! 0.0 means zero net charge transfer / potential of zero charge
      TARGET_POTENTIAL 0.0
      
      ! Direction perpendicular to electrode surface
      DIPOLE_DIRECTION Z
      
      ! Geometric capacitance in attofarads - controls response speed
      ! Larger values = faster but may oscillate
      GEOMETRIC_CAPACITANCE 0.05
      
      ! Time constant for thermopotentiostat response in femtoseconds
      TIMECON 100.0
      
      ! Element to modify - the working electrode material
      ELEMENT Ne
      
      ! Limits on the zeff correction to prevent unphysical states
      MAX_ZEFF_CORRECTION 0.5
      MIN_ZEFF_CORRECTION -0.5
    &END THERMOPOTENTIOSTAT
    
    &PRINT
      ! Output thermopotentiostat data (dipole, zeff_corr) to file
      &THERMOPOTENTIOSTAT
        &EACH
          MD 1
        &END EACH
      &END THERMOPOTENTIOSTAT
      
      ! Standard MD output
      &ENERGY
        &EACH
          MD 1
        &END EACH
      &END ENERGY
      
      &PROGRAM_RUN_INFO
        &EACH
          MD 10
        &END EACH
      &END PROGRAM_RUN_INFO
    &END PRINT
    
  &END MD
  
  &PRINT
    &TRAJECTORY
      &EACH
        MD 10
      &END EACH
    &END TRAJECTORY
    &VELOCITIES OFF
    &END VELOCITIES
    &FORCES OFF
    &END FORCES
    &RESTART
      &EACH
        MD 100
      &END EACH
    &END RESTART
  &END PRINT
  
&END MOTION
