&GLOBAL
  PROJECT simple_OT_thermopotentiostat
  RUN_TYPE MD
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    
    ! Surface dipole correction - REQUIRED for thermopotentiostat
    SURFACE_DIPOLE_CORRECTION .TRUE.
    SURF_DIP_DIR Z
    ! CORE_CORR_DIP is now automatically enabled by the thermopotentiostat
    
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
    &END MGRID
    
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    
    ! OT-based SCF - now compatible with CORE_CORRECTION
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-5
      MAX_SCF 30
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        MAX_SCF 5
        EPS_SCF 1.0E-5
      &END OUTER_SCF
    &END SCF
    
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    
    ! Print dipole moment
    &PRINT
      &MOMENTS ON
        PERIODIC FALSE
        REFERENCE COM
      &END MOMENTS
    &END PRINT
    
  &END DFT
  
  &SUBSYS
    &CELL
      ABC 6.0 6.0 15.0
      PERIODIC XYZ
    &END CELL
    
    ! Simple test system: 2 water molecules in a slab geometry
    &COORD
      O   3.0  3.0  5.0
      H   3.0  3.8  5.5
      H   3.0  2.2  5.5
      O   3.0  3.0 10.0
      H   3.0  3.8  9.5
      H   3.0  2.2  9.5
    &END COORD
    
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q6
      ! CORE_CORRECTION is optional - thermopotentiostat dynamically sets zeff_correction
    &END KIND
    
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &MD
    ENSEMBLE THERMOPOTENTIOSTAT
    TIMESTEP 0.5
    STEPS 5
    TEMPERATURE 300.0
    
    &THERMOPOTENTIOSTAT
      TARGET_POTENTIAL 0.0
      DIPOLE_DIRECTION Z
      GEOMETRIC_CAPACITANCE 0.01
      TIMECON 100.0
      ELEMENT O
      MAX_ZEFF_CORRECTION 0.1
      MIN_ZEFF_CORRECTION -0.1
    &END THERMOPOTENTIOSTAT
    
    &PRINT
      &THERMOPOTENTIOSTAT
        &EACH
          MD 1
        &END EACH
      &END THERMOPOTENTIOSTAT
      &ENERGY
        &EACH
          MD 1
        &END EACH
      &END ENERGY
      &TRAJECTORY
        &FORMAT EXTXYZ
        &EACH
          MD 1
        &END EACH
      &END TRAJECTORY
    &END PRINT
    
  &END MD
&END MOTION
